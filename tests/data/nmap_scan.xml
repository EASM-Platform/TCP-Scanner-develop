            <elem key="redis_version">6.0.16</elem>
            <elem key="os">Linux 5.15.0 x86_64</elem>
          </table>
        </script>
      </port>
      <port protocol="tcp" portid="9000">
        <state state="open" />
        <service name="unknown" product="Custom Gateway" version="1.2.3" />
        <script id="banner" output="opaque handshake token and full custom banner text" />
      </port>
    </ports>
  </host>
</nmaprun>
