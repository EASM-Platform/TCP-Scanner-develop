      <port protocol="tcp" portid="80">
        <state state="open" />
        <service name="http" product="Apache httpd" version="2.4.62" extrainfo="Ubuntu" />
        <script id="http-server-header" output="Apache/2.4.62 (Ubuntu)" />
        <script id="http-title" output="Welcome to Apache" />
        <script id="http-headers" output="HTTP/1.1 200 OK&#10;Server: Apache/2.4.62 (Ubuntu)&#10;X-Powered-By: EASM Lab&#10;" />
